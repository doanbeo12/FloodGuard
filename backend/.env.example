# Railway MySQL service can expose MYSQLHOST/MYSQLPORT/MYSQLUSER/MYSQLPASSWORD/MYSQLDATABASE/MYSQL_URL.
# The modified db.js accepts those directly, so DB_* is optional on Railway.

PORT=3001

MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC=flood-monitoring/a8f3c2/data
DB_SAMPLE_INTERVAL_MS=10000
CENTRAL_TIMEOUT_MS=30000
DEFAULT_SITE_ID=1

WEATHER_LAT=10.7769
WEATHER_LON=106.7009
WEATHER_CACHE_MINUTES=10
WEATHER_HTTP_TIMEOUT_MS=15000

TIDE_AUTO_FETCH=true
TIDE_SOURCE_BASE_URL=https://www.phongchonglutbaotphcm.gov.vn
TIDE_FETCH_INTERVAL_MINUTES=60
TIDE_ARCHIVE_MONTH_LOOKBACK=12
TIDE_HTTP_TIMEOUT_MS=20000
TIDE_SAVE_PDF=false
TIDE_STALE_HOURS=48
TIDE_SAVE_PARSE_DEBUG=false

FLOOD_CAUSE_WATER_THRESHOLD_CM=3
FLOOD_CAUSE_TIDE_WINDOW_MINUTES=180
